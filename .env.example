# Google Sheets live data source
# Copy this file to .env.local and fill in your spreadsheet ID.
#
# 1. Upload resources/Gymnastics data.xlsx to Google Sheets (or create a new sheet
#    with the same tab names and column layout).
# 2. Share the spreadsheet: "Anyone with the link" → Viewer.
# 3. Copy the ID from the URL:
#    https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
#
VITE_GOOGLE_SHEETS_ID=1L63Vp5RpIcu5GQTE-hK2OhSfKNLfmh_9MEOYmy4xi_k

# Optional — helps the app resolve truncated sheet tab names.
# Create a free API key in Google Cloud Console with Sheets API enabled,
# restricted to your domain and read-only access.
# VITE_GOOGLE_API_KEY=
